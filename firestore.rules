rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profile ────────────────────────────────────────────────────────
    // Users can only read and write their own top-level document
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // ── AI usage subcollection ─────────────────────────────────────────
      // Tracks daily AI call counts. Users can read their own usage;
      // writes come from the app (SharedPreferences is the source of truth,
      // Firestore is just for visibility / server-side enforcement later).
      match /usage/{doc} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null
                     && request.auth.uid == userId
                     // Enforce schema: only these fields allowed
                     && request.resource.data.keys().hasOnly(['count', 'date', 'lastUsed'])
                     // Count must be a positive integer ≤ 200 (generous server-side cap)
                     && request.resource.data.count is int
                     && request.resource.data.count >= 0
                     && request.resource.data.count <= 200;
      }
    }

    // ── Deny everything else by default ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
